# Porta em que a Evolution Go atenderá (padrão 8080)
SERVER_PORT=8080

# Chave Global de Segurança para acessar a Evolution Go
# IMPORTANTE: Altere para uma chave forte e secreta
GLOBAL_API_KEY=evol_go_sec_crm_987654321_token

# Nome do cliente/projeto
CLIENT_NAME=evolution_crm

# Credenciais do Banco interno da VPS para a Evolution Go
EVO_DB_USER=postgres
EVO_DB_PASSWORD=evolution_secret_password_2026

# URL do Webhook do seu CRM (Cloudflare Worker ou Local para desenvolvimento)
# Em produção: https://api.seucrm.com.br/webhook
# Em desenvolvimento local com Docker: http://host.docker.internal:8787/webhook
WEBHOOK_GLOBAL_URL=http://host.docker.internal:8787/webhook
